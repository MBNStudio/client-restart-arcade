# Généré par scripts/gen-htaccess.mjs depuis docs/redirections.md : ne pas éditer à la main.
# Hébergement : o2switch (Apache), site statique (export Next.js) à la racine de restart-arcade.fr.

RewriteEngine On

# Adresse unique : https, sans www.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www. [NC]
RewriteRule ^ https://restart-arcade.fr%{REQUEST_URI} [L,R=301]

# Pages sans équivalent (410)
Redirect gone /sample-page/
Redirect gone /test/
Redirect gone /test-2/
Redirect gone /panier/
Redirect gone /commande/

# Redirections de l'ancien site (301)
Redirect 301 /accueil/ /entreprises/
Redirect 301 /accueil-particulier/ /particuliers/
